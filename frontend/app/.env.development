# 开发环境变量
# 在开发模式下使用 (npm run dev)

# API 基础 URL - 开发环境（需与后端 SERVER_PORT 10006 一致）
VITE_API_BASE_URL=http://127.0.0.1:10006
#VITE_API_BASE_URL=https://service.fastapiadmin.com

# 环境名称
VITE_ENV_NAME=development

# 项目名称
VITE_APP_TITLE=fastapiadmin

# 代理前缀
VITE_APP_BASE_API=/api/v1

# 应用端口（建议设为 5181，避免与 Web 端 5180 端口冲突）
VITE_APP_PORT=5181

# 超时时间
VITE_TIMEOUT=10000

# WebSocket 服务器的 URL（需指向后端 8001 端口）
VITE_APP_WS_ENDPOINT=ws://127.0.0.1:10006
#VITE_APP_WS_ENDPOINT=wss://service.fastapiadmin.com
